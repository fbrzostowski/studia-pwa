{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "target": "files",
      "rules": "storage.rules"
    },
    {
      "target": "closed",
      "rules": "storage.deny.rules"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "src",
        "tsconfig.json"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/register",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/authorize",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/token",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/**",
        "function": {
          "functionId": "mcp",
          "region": "europe-west1"
        }
      }
    ]
  }
}