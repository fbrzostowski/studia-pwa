rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() { return request.auth != null; }
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'approved';
    }
    function isAdmin() { return isApproved() && me().role == 'admin'; }
    // nazwa pokazywana innym; ta sama logika co w aplikacji (username, a dla starszych kont nazwa z Google)
    function memberName() { return me().get('username', me().get('displayName', '')); }
    // opcjonalne podpięcie materiału do konkretnej lekcji (data + forma + grupa)
    function validLesson(d) {
      return !('lessonDate' in d)
        || (d.lessonDate is string && d.lessonDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && d.lessonForm in ['WYK', 'LAB', 'KON', 'CW']
            && d.lessonGroup is string && d.lessonGroup.size() <= 20);
    }
    function validKind(k) { return k in ['WYK', 'LAB', 'KON', 'CW', 'WYK+CW', 'KON+CW']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // pierwsze logowanie: wyłącznie pending/user, z nazwą użytkownika zarezerwowaną
      // na to samo uid w tej samej paczce zapisów (kolekcja usernames)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'user'
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-zA-Z0-9_.-]{3,20}$')
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
      // user może zmienić tylko pola profilu, nie role/status/review*
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'email', 'photoURL']);
      // admin zmienia wszystko (zatwierdzanie, role)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // rezerwacje nazw użytkowników: id dokumentu = nazwa małymi literami
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && name.matches('^[a-z0-9_.-]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow delete: if isAdmin();
    }

    // osobisty plan zajęć z USOS: jeden dokument na użytkownika, widoczny tylko dla niego
    match /plans/{uid} {
      allow read, delete: if isApproved() && request.auth.uid == uid;
      allow create, update: if isApproved() && request.auth.uid == uid
                            && request.resource.data.events is list
                            && request.resource.data.events.size() <= 1000;
    }

    match /subjects/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid
                    && validKind(request.resource.data.kind);
      allow update: if (isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid))
                    && validKind(request.resource.data.kind);
      allow delete: if isAdmin()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // przynależność do przedmiotu i do konkretnych grup zajęciowych (z planu USOS)
    match /memberships/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
                            && request.resource.data.keys().hasOnly(['uid', 'subjectId', 'username', 'classes', 'updatedAt'])
                            && request.resource.data.uid == request.auth.uid
                            && id == request.resource.data.subjectId + '_' + request.auth.uid
                            && request.resource.data.username == memberName()
                            && request.resource.data.classes is list
                            && request.resource.data.classes.size() <= 20
                            && existsAfter(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId));
      allow delete: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // wspólne dane grupy zajęciowej (prowadzący); edytuje każdy zatwierdzony uczestnik
    match /classes/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
                            && request.resource.data.keys().hasOnly(['subjectId', 'form', 'group', 'lecturer', 'updatedBy', 'updatedAt'])
                            && request.resource.data.updatedBy == request.auth.uid
                            && request.resource.data.lecturer is string
                            && request.resource.data.lecturer.size() <= 80
                            && request.resource.data.form in ['WYK', 'LAB', 'KON', 'CW']
                            && request.resource.data.group.matches('^[A-Za-z0-9_.-]{1,20}$')
                            && id == request.resource.data.subjectId + '_' + request.resource.data.form + '_' + request.resource.data.group
                            && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId));
      allow delete: if isAdmin();
    }

    match /materials/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.ownerId == request.auth.uid
                    && validLesson(request.resource.data);
      allow update: if (isAdmin() || (isApproved() && resource.data.ownerId == request.auth.uid))
                    && validLesson(request.resource.data);
      allow delete: if isAdmin()
        || (isApproved() && resource.data.ownerId == request.auth.uid);
    }

    match /exams/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /textbooks/{docId} {
      allow read: if isApproved();
      allow write: if false; // tylko Cloud Function (Admin SDK)
    }

    // foldery przedmiotów na Drive (zapisuje Cloud Function): po nich wiadomo, które przedmioty mają folder
    match /textbookFolders/{docId} {
      allow read: if isApproved();
      allow write: if false;
    }

    // stan synchronizacji podręczników (zapisuje Cloud Function)
    match /meta/{docId} {
      allow read: if isApproved();
      allow write: if false;
    }
  }
}
