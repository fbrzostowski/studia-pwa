rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() { return request.auth != null; }
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'approved';
    }
    function isAdmin() { return isApproved() && me().role == 'admin'; }
    // nazwa pokazywana innym; ta sama logika co w aplikacji (username, a dla starszych kont nazwa z Google)
    function memberName() { return me().get('username', me().get('displayName', '')); }
    // opcjonalne podpięcie materiału do konkretnej lekcji (data + forma + grupa)
    function validLesson(d) {
      return !('lessonDate' in d)
        || (d.lessonDate is string && d.lessonDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && d.lessonForm in ['WYK', 'LAB', 'KON', 'CW']
            && d.lessonGroup is string && d.lessonGroup.size() <= 20);
    }
    // termin zaliczenia: mid-term (MID), final exam (FIN) albo quiz (QUIZ) dla istniejącego przedmiotu
    function validExam(d) {
      return d.keys().hasOnly(['subjectId', 'type', 'date', 'time', 'room', 'note', 'form', 'group', 'onlyFor', 'createdBy', 'createdByName', 'createdAt'])
        && d.keys().hasAll(['subjectId', 'type', 'date', 'createdBy'])
        && d.type in ['MID', 'FIN', 'QUIZ']
        && d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('time' in d) || (d.time is string && d.time.matches('^([01]\\d|2[0-3]):[0-5]\\d$')))
        && (!('room' in d) || (d.room is string && d.room.size() <= 100))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('createdByName' in d) || (d.createdByName is string && d.createdByName.size() <= 60))
        // grupa zajęciowa (forma + numer, tylko razem) albo „tylko dla autora”, ale nie jedno i drugie
        && (('form' in d) == ('group' in d))
        && (!('form' in d) || d.form in ['WYK', 'LAB', 'KON', 'CW'])
        && (!('group' in d) || (d.group is string && d.group.matches('^[A-Za-z0-9_.-]{1,20}$')))
        && (!('onlyFor' in d) || (d.onlyFor == d.createdBy && !('group' in d)))
        && exists(/databases/$(database)/documents/subjects/$(d.subjectId));
    }
    // prywatna lista do nauki: nazwa, opcjonalny przedmiot i lista punktów z odznaczeniami
    function validTodo(d) {
      return d.keys().hasOnly(['ownerId', 'name', 'subjectId', 'items', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerId', 'name', 'items'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && (!('subjectId' in d) || d.subjectId is string)
        && d.items is list && d.items.size() <= 300;
    }
    // opcjonalna emotka przedmiotu (jedna, krótka; pilnuje tego też klient)
    function validEmoji(d) { return !('emoji' in d) || (d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 32); }
    function validKind(k) { return k in ['WYK', 'LAB', 'KON', 'CW', 'WYK+CW', 'KON+CW']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // pierwsze logowanie: wyłącznie pending/user, z nazwą użytkownika zarezerwowaną
      // na to samo uid w tej samej paczce zapisów (kolekcja usernames)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'user'
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-zA-Z0-9_.-]{3,20}$')
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
      // user może zmienić tylko pola profilu, nie role/status/review*
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'email', 'photoURL']);
      // admin zmienia wszystko (zatwierdzanie, role)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // rezerwacje nazw użytkowników: id dokumentu = nazwa małymi literami
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && name.matches('^[a-z0-9_.-]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow delete: if isAdmin();
    }

    // plan zajęć z USOS: jeden dokument na użytkownika. Czytają go wszyscy zatwierdzeni (to grupa znajomych),
    // zapisuje i usuwa tylko właściciel, a admin może poprawiać w nim wyłącznie listę zajęć
    match /plans/{uid} {
      allow read: if isApproved();
      allow delete: if isApproved() && request.auth.uid == uid;
      allow create, update: if isApproved() && request.auth.uid == uid
                            && request.resource.data.events is list
                            && request.resource.data.events.size() <= 1000;
      // admin poprawia zajęcia w dowolnym planie, ale zmienia wyłącznie listę zajęć (nie nazwę pliku)
      allow update: if isAdmin()
                    && request.resource.data.events is list
                    && request.resource.data.events.size() <= 1000
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events']);
    }

    // listy do nauki są prywatne: widzi i zmienia je tylko właściciel (także admin nie ma wglądu)
    match /todoLists/{id} {
      allow read, delete: if isApproved() && resource.data.ownerId == request.auth.uid;
      allow create: if isApproved() && request.resource.data.ownerId == request.auth.uid
                    && validTodo(request.resource.data);
      allow update: if isApproved() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && validTodo(request.resource.data);
    }

    match /subjects/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid
                    && validKind(request.resource.data.kind)
                    && validEmoji(request.resource.data);
      // autorstwo jest niezmienne: tylko autor lub admin zmienia i usuwa wpis, i nikt nie przepisuje go na kogoś innego
      allow update: if (isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid))
                    && validKind(request.resource.data.kind)
                    && validEmoji(request.resource.data)
                    && request.resource.data.createdBy == resource.data.createdBy;
      // emotkę (wspólną ikonę przedmiotu) może ustawić każdy zatwierdzony, ale nic poza nią
      allow update: if isApproved()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
                    && validEmoji(request.resource.data);
      allow delete: if isAdmin()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    // przynależność do przedmiotu i do konkretnych grup zajęciowych (z planu USOS)
    match /memberships/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
                            && request.resource.data.keys().hasOnly(['uid', 'subjectId', 'username', 'photoURL', 'classes', 'updatedAt'])
                            && request.resource.data.uid == request.auth.uid
                            && id == request.resource.data.subjectId + '_' + request.auth.uid
                            && request.resource.data.username == memberName()
                            // zdjęcie tylko własne (kopia z profilu), żeby inni widzieli miniaturkę bez dostępu do users
                            && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == me().get('photoURL', ''))
                            && request.resource.data.classes is list
                            && request.resource.data.classes.size() <= 20
                            && existsAfter(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId));
      allow delete: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // wspólne dane grupy zajęciowej (prowadzący); edytuje każdy zatwierdzony uczestnik
    match /classes/{id} {
      allow read: if isApproved();
      allow create, update: if isApproved()
                            && request.resource.data.keys().hasOnly(['subjectId', 'form', 'group', 'lecturer', 'updatedBy', 'updatedAt'])
                            && request.resource.data.updatedBy == request.auth.uid
                            && request.resource.data.lecturer is string
                            && request.resource.data.lecturer.size() <= 80
                            && request.resource.data.form in ['WYK', 'LAB', 'KON', 'CW']
                            && request.resource.data.group.matches('^[A-Za-z0-9_.-]{1,20}$')
                            && id == request.resource.data.subjectId + '_' + request.resource.data.form + '_' + request.resource.data.group
                            && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId));
      allow delete: if isAdmin();
    }

    match /materials/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.ownerId == request.auth.uid
                    && validLesson(request.resource.data);
      allow update: if (isAdmin() || (isApproved() && resource.data.ownerId == request.auth.uid))
                    && validLesson(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAdmin()
        || (isApproved() && resource.data.ownerId == request.auth.uid);
    }

    match /exams/{docId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.createdBy == request.auth.uid
                    && validExam(request.resource.data);
      allow update: if (isAdmin() || (isApproved() && resource.data.createdBy == request.auth.uid))
                    && validExam(request.resource.data)
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin()
        || (isApproved() && resource.data.createdBy == request.auth.uid);
    }

    match /textbooks/{docId} {
      allow read: if isApproved();
      allow write: if false; // tylko Cloud Function (Admin SDK)
    }

    // foldery przedmiotów w podręcznikach (zapisuje Cloud Function): po nich wiadomo, które przedmioty mają folder
    match /textbookFolders/{docId} {
      allow read: if isApproved();
      allow write: if false;
    }
  }
}
